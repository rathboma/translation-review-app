+// The live English page comes from the static assets, as the queue consumer
+// reads it.
+const ASSETS_ORIGIN = "https://assets.invalid";
+
+async function annotated(url: URL, env: Env, store: Store): Promise<Response> {
+  const lang = url.searchParams.get("lang") ?? "";
+  const path = url.searchParams.get("path") ?? "";
+  const manifest = await store.manifest(true);
+  if (!manifest) return json({ error: "no manifest yet: run a deploy first" }, 409);
+  if (!manifest.languages[lang]) return json({ error: `${lang || "(no lang)"} is not a translated language` }, 404);
+  if (!manifest.pages.includes(path)) return json({ error: `${path || "(no path)"} is not a translated page` }, 404);
+  const resolved = await store.resolved(lang, path);
+  if (!resolved) return json({ error: `${path} is not translated yet in ${lang}` }, 404);
+  const english = await env.ASSETS.fetch(new Request(ASSETS_ORIGIN + path, { redirect: "manual" }));
+  if (!english.ok) return json({ error: `the English page ${path} is not available (${english.status})` }, 502);
+  try {
+    const page = annotate(await english.text(), resolved.segments, new Layer(manifest, lang, path));
+    return json({ lang, path, fingerprint: resolved.fingerprint, ...page });
+  } catch (error) {
+    if (error instanceof NotAPage) return json({ error: error.message }, 502);
+    throw error;
+  }
+}
