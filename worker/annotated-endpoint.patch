+++ b/workers/translate/src/annotate.ts
@@ -0,0 +1,116 @@
+// A page for review (translate.beekeeperstudio.io): the live English page and
+// the current copy of it, both marked up with `data-seg="<id>"` on the element
+// of every html segment (a bare text node is wrapped in <span data-seg>), plus
+// the list of segments with their translations and where they come from.
+//
+// A segment here is a distinct (scope, key): the same English twice on a page
+// is one segment with one id, on every element that holds it, because a
+// correction changes both. Attribute and head segments are in the list but not
+// in the markup.
+//
+// The ids are assigned by one walk (`segments()`, then the head) over each of
+// two parses of the live English page, so they are the same on both sides. The
+// copy is that second tree with its translations applied, not the stored copy
+// walked again: a translation that moves a link's text into the link would
+// stop its paragraph being a segment and shift every id after it.
+import { defaultTreeAdapter, html as parse5Html } from "parse5";
+import { serializeDocument, setAttr, type Element, type ParentNode, type TextNode } from "./dom.ts";
+import { parsePage, type Page } from "./page.ts";
+import { NotAPage, type ResolvedSegment } from "./render.ts";
+import type { Layer, Source } from "./resolve.ts";
+import type { Kind } from "./segments.ts";
+import { normalize } from "./text.ts";
+import { apply } from "./translator.ts";
+
+export interface AnnotatedSegment {
+  id: string;
+  key: string;
+  kind: Kind | "head";
+  where: string;
+  scope: string | null;
+  source: Source;
+  translation: string | null;
+  // source explicit: the path of the entry that applies (an exact url, a glob
+  // or *), which is where a correction goes.
+  entryPath?: string;
+}
+
+export interface Annotated {
+  english: string;
+  translated: string;
+  segments: AnnotatedSegment[];
+}
+
+const idOf = (scope: string | null, key: string) => `${scope ?? ""}\t${key}`;
+
+type Listed = Pick<AnnotatedSegment, "id" | "key" | "kind" | "where" | "scope">;
+
+// Gives every segment of the page its id, in the order they first occur.
+function mark(page: Page): { listed: Listed[]; texts: [TextNode, string][] } {
+  const ids = new Map<string, string>();
+  const listed: Listed[] = [];
+  const texts: [TextNode, string][] = [];
+  const idFor = (scope: string | null, key: string, make: () => Omit<Listed, "id">) => {
+    const k = idOf(scope, key);
+    let id = ids.get(k);
+    if (!id) {
+      id = `s${ids.size + 1}`;
+      ids.set(k, id);
+      listed.push({ id, ...make() });
+    }
+    return id;
+  };
+  for (const s of page.segments) {
+    const id = idFor(s.scope, s.key, () => ({ key: s.key, kind: s.kind, where: s.where, scope: s.scope }));
+    if (s.kind === "html") setAttr(s.node as Element, "data-seg", id);
+    else if (s.kind === "text") texts.push([s.node as TextNode, id]);
+  }
+  for (const h of page.head.segments) idFor(null, h.key, () => ({ key: h.key, kind: "head", where: h.where, scope: null }));
+  return { listed, texts };
+}
+
+// <span data-seg> around each text node. Done after the translations are in,
+// since a span would make its text an html segment of its own.
+function wrap(texts: [TextNode, string][]): void {
+  for (const [node, id] of texts) {
+    const parent = node.parentNode as ParentNode;
+    const span = defaultTreeAdapter.createElement("span", parse5Html.NS.HTML, [{ name: "data-seg", value: id }]);
+    defaultTreeAdapter.insertBefore(parent, span, node);
+    defaultTreeAdapter.detachNode(node);
+    defaultTreeAdapter.appendChild(span, node);
+  }
+}
+
+// `resolved`: what the Worker stored for the copy (`store.resolved()`, what
+// `export` returns). A segment it doesn't know (the English changed since) is
+// english: untranslated.
+export function annotate(html: string, resolved: ResolvedSegment[], layer: Layer): Annotated {
+  const english = parsePage(html);
+  const copy = parsePage(html);
+  if (!english || !copy) throw new NotAPage("the page has no <body>");
+  const side = mark(english);
+  // The same ids, since it is the same walk over the same html.
+  const copySide = mark(copy);
+  const known = new Map(resolved.map((r) => [idOf(r.scope, r.english), r]));
+  const translation = (key: string, scope: string | null) => known.get(idOf(scope, key))?.translation ?? undefined;
+
+  // The copy: the English page's second tree, translated.
+  apply(copy.body, (key, scope) => translation(key, scope));
+  for (const h of copy.head.segments) {
+    const value = translation(h.key, null);
+    if (value !== undefined) h.set(value);
+  }
+  copy.head.commit();
+  wrap(side.texts);
+  wrap(copySide.texts);
+
+  // The explicit entry that wins for a key is the first that applies to the
+  // page, as Layer picks it.
+  const entryPath = (key: string) => layer.entries.find((e) => e.en !== undefined && e.translation !== undefined && normalize(e.en) === key)?.path;
+  const segments = side.listed.map((s): AnnotatedSegment => {
+    const r = known.get(idOf(s.scope, s.key));
+    const source = r?.source ?? "english";
+    return { ...s, source, translation: r?.translation ?? null, ...(source === "explicit" ? { entryPath: entryPath(s.key) } : {}) };
+  });
+  return { english: serializeDocument(english.doc), translated: serializeDocument(copy.doc), segments };
+}
