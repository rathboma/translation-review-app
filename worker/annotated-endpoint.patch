@@ -0,0 +1,103 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { api } from "../src/api.ts";
+import type { Env, Resolved } from "../src/cloudflare.ts";
+import type { Manifest } from "../src/config.ts";
+import { FixtureTranslator } from "../src/claude.ts";
+import { render } from "../src/render.ts";
+import { pathKey, MemorySegmentStore } from "../src/store.ts";
+import { manifest, page } from "./fixtures.ts";
+
+const TOKEN = "t0ken";
+const ES = { Pricing: "Precios", "Plans for everyone": "Planes para todos", "Pay once.": "Paga una vez.", Download: "Descarga", Features: "Funciones", "Change language": "Cambiar idioma" };
+
+interface World {
+  manifest?: Manifest | null;
+  resolved?: Record<string, Resolved>;
+  // English pages by path, or a status for one that isn't there.
+  assets?: Record<string, string | number>;
+}
+
+// Just enough of KV, R2 and the static assets for the annotated endpoint.
+function fakeEnv(world: World): Env {
+  const m = world.manifest === undefined ? manifest() : world.manifest;
+  return {
+    TRANSLATIONS_TOKEN: TOKEN,
+    TRANSLATIONS: { get: async (key: string) => (key === "manifest" ? m : null) },
+    PAGES: { get: async (key: string) => (world.resolved?.[key] ? { json: async () => world.resolved![key] } : null) },
+    ASSETS: {
+      fetch: async (request: Request) => {
+        const found = world.assets?.[new URL(request.url).pathname];
+        if (typeof found === "string") return new Response(found, { headers: { "content-type": "text/html" } });
+        return new Response("", { status: found ?? 404 });
+      },
+    },
+  } as unknown as Env;
+}
+
+async function resolvedCopy(html: string, path = "/pricing/", lang = "es"): Promise<Resolved> {
+  const result = await render({ html, path, lang, manifest: manifest(), store: new MemorySegmentStore(), translator: new FixtureTranslator(ES) });
+  return { lang, path, fingerprint: result.fingerprint, status: result.partial ? "partial" : "ok", updated: "2026-10-20T00:00:00Z", segments: result.segments };
+}
+
+const get = (env: Env, query: string, token: string | null = TOKEN) =>
+  api(new Request(`https://www.beekeeperstudio.io/_translations/annotated?${query}`, { headers: token ? { authorization: `Bearer ${token}` } : {} }), env);
+
+test("a page for review: both sides, the fingerprint of the copy and its segments", async () => {
+  const html = page();
+  const resolved = await resolvedCopy(html);
+  const env = fakeEnv({ resolved: { "resolved/es/pricing/index.json": resolved }, assets: { "/pricing/": html } });
+  const response = await get(env, "lang=es&path=/pricing/");
+  assert.equal(response.status, 200);
+  const body = (await response.json()) as any;
+  assert.deepEqual(Object.keys(body).sort(), ["english", "fingerprint", "lang", "path", "segments", "translated"]);
+  assert.equal(body.fingerprint, resolved.fingerprint);
+  assert.match(body.english, /<p data-seg="s\d+">Pay once\.<\/p>/);
+  assert.match(body.translated, /<p data-seg="s\d+">Paga una vez\.<\/p>/);
+  const pay = body.segments.find((s: any) => s.key === "Pay once.");
+  assert.match(body.english, new RegExp(`data-seg="${pay.id}"`));
+  assert.deepEqual([pay.kind, pay.source, pay.translation, pay.scope], ["html", "generated", "Paga una vez.", null]);
+  assert.equal(body.segments.length, resolved.segments.length);
+});
