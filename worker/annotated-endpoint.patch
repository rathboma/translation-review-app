diff --git a/workers/translate/test/annotate.test.ts b/workers/translate/test/annotate.test.ts
new file mode 100644
index 0000000..dba118f
--- /dev/null
+++ b/workers/translate/test/annotate.test.ts
@@ -0,0 +1,164 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { annotate } from "../src/annotate.ts";
+import { FixtureTranslator } from "../src/claude.ts";
+import { attr, elements, parseDocument, textContent } from "../src/dom.ts";
+import { render } from "../src/render.ts";
+import { Layer } from "../src/resolve.ts";
+import { MemorySegmentStore } from "../src/store.ts";
+import { manifest, page } from "./fixtures.ts";
+
+const ES: Record<string, string> = {
+  Pricing: "Precios",
+  Plans: "Planes",
+  "Plans for everyone": "Planes para todos",
+  "Pay once.": "Paga una vez.",
+  Download: "Descarga",
+  Features: "Funciones",
+  "Change language": "Cambiar idioma",
+  "Loose words": "Palabras sueltas",
+  "A block": "Un bloque",
+  "A logo": "Un logotipo",
+  Tip: "Consejo",
+  Go: "Ir",
+};
+
+// The page as rendered and stored, then annotated, as the Worker does it.
+async function annotated(html: string, strings: Record<string, string> = ES, m = manifest()) {
+  const result = await render({ html, path: "/pricing/", lang: "es", manifest: m, store: new MemorySegmentStore(), translator: new FixtureTranslator(strings) });
+  const out = annotate(html, result.segments, new Layer(m, "es", "/pricing/"));
+  return { result, out };
+}
+
+const marked = (html: string) => elements(parseDocument(html)).filter((el) => attr(el, "data-seg") !== undefined);
+const idsIn = (html: string) => new Set(marked(html).map((el) => attr(el, "data-seg")!));
+const byId = (html: string, id: string) => marked(html).filter((el) => attr(el, "data-seg") === id);
+
+const RICH = page({
+  title: "Plans",
+  main: `<h1>Pricing</h1><p>Pay once.</p>Loose words<div>A block</div><a href="/get">Download</a><img src="/a.png" alt="A logo"><button title="Tip">Go</button>`,
+});
+
+test("both sides carry the same ids, and every segment export returns has one", async () => {
+  const { result, out } = await annotated(RICH);
+  assert.deepEqual([...idsIn(out.english)].sort(), [...idsIn(out.translated)].sort());
+  for (const s of result.segments) {
+    const found = out.segments.find((a) => a.key === s.english && a.scope === s.scope);
+    assert.ok(found, `no id for ${JSON.stringify(s.english)} (${s.scope})`);
+    assert.equal(found.where, s.where);
+    assert.equal(found.source, s.source);
+    assert.equal(found.translation, s.translation);
+  }
+  assert.equal(new Set(out.segments.map((s) => s.id)).size, out.segments.length, "ids are unique");
+  // Every html and text segment is in the markup, on both sides; attribute and head segments are not.
+  for (const s of out.segments) {
+    const inMarkup = s.kind === "html" || s.kind === "text";
+    assert.equal(byId(out.english, s.id).length > 0, inMarkup, `${s.kind} ${s.key} in english`);
+    assert.equal(byId(out.translated, s.id).length > 0, inMarkup, `${s.kind} ${s.key} in translated`);
+  }
+});
+
+test("the English side is the live page, the other is its copy", async () => {
+  const { out } = await annotated(RICH);
+  const pay = out.segments.find((s) => s.key === "Pay once.")!;
+  assert.deepEqual(byId(out.english, pay.id).map(textContent), ["Pay once."]);
+  assert.deepEqual(byId(out.translated, pay.id).map(textContent), ["Paga una vez."]);
+  assert.equal(pay.translation, "Paga una vez.");
+  assert.equal(pay.source, "generated");
+});
+
+test("a bare text node is wrapped in a span with its id, on both sides", async () => {
+  const { out } = await annotated(RICH);
+  const loose = out.segments.find((s) => s.key === "Loose words")!;
+  assert.equal(loose.kind, "text");
+  for (const [html, text] of [[out.english, "Loose words"], [out.translated, "Palabras sueltas"]]) {
+    const [span] = byId(html, loose.id);
+    assert.equal(span.tagName, "span");
+    assert.equal(textContent(span), text);
+  }
+});
+
+test("attribute and head segments are listed with their kind but are not in the markup", async () => {
+  const { out } = await annotated(RICH);
+  const alt = out.segments.find((s) => s.key === "A logo")!;
+  assert.deepEqual([alt.kind, alt.where, alt.translation], ["attr", 'img[alt], under "Pricing"', "Un logotipo"]);
+  const title = out.segments.find((s) => s.key === "Plans")!;
+  assert.deepEqual([title.kind, title.where, title.translation], ["head", "title", "Planes"]);
+  assert.ok(!out.english.includes(`data-seg="${alt.id}"`));
+  assert.match(out.translated, /alt="Un logotipo"/, "the copy has the translated alt text");
+  assert.match(out.translated, /<title>Planes \| Beekeeper Studio<\/title>/);
+});
+
+test("the same English twice is one segment, and every element that holds it has its id", async () => {
+  const { out } = await annotated(page({ main: "<p>Pay once.</p><p>Pay once.</p><h1>Pricing</h1>" }));
+  const pay = out.segments.filter((s) => s.key === "Pay once.");
+  assert.equal(pay.length, 1);
+  assert.equal(byId(out.english, pay[0].id).length, 2);
+  assert.equal(byId(out.translated, pay[0].id).length, 2);
+});
+
+test("the same English in a shared include is its own segment, from the common layer", async () => {
+  const { out } = await annotated(RICH);
+  const header = out.segments.find((s) => s.key === "Download" && s.scope === "header")!;
+  const main = out.segments.find((s) => s.key === "Download" && s.scope === null)!;
+  assert.notEqual(header.id, main.id);
+  assert.deepEqual([header.source, header.translation], ["common", "Descargar"]);
+  assert.deepEqual([main.source, main.translation], ["generated", "Descarga"]);
+  assert.deepEqual(byId(out.translated, header.id).map(textContent), ["Descargar"]);
+  // (the page has two such links in its main: one segment, both elements carry its id)
+  assert.deepEqual(byId(out.translated, main.id).map(textContent), ["Descarga", "Descarga"]);
+});
+
+test("a translation that moves a link's text still has its id (the copy is not walked again)", async () => {
+  const key = 'Read <a href="/docs">the docs</a> now';
+  const moved = '<a href="/docs">Lee los documentos ahora</a>';
+  const html = page({ main: `<h1>Pricing</h1><p>${key}</p><p>Pay once.</p>` });
+  const { out } = await annotated(html, { ...ES, [key]: moved });
+  const docs = out.segments.find((s) => s.key === key)!;
+  const [p] = byId(out.translated, docs.id);
+  assert.equal(p.tagName, "p");
+  assert.equal(textContent(p), "Lee los documentos ahora");
+  // The paragraph after it is the same segment on both sides, too.
+  const pay = out.segments.find((s) => s.key === "Pay once.")!;
+  assert.deepEqual(byId(out.english, pay.id).map(textContent), ["Pay once."]);
+  assert.deepEqual(byId(out.translated, pay.id).map(textContent), ["Paga una vez."]);
+  assert.deepEqual([...idsIn(out.english)].sort(), [...idsIn(out.translated)].sort());
+});
+
+test("a segment the stored copy doesn't know (the English changed since) is english and stays English", async () => {
+  const { result } = await annotated(RICH);
+  const changed = RICH.replace("Pay once.", "Pay once, use forever.");
+  const out = annotate(changed, result.segments, new Layer(manifest(), "es", "/pricing/"));
+  const fresh = out.segments.find((s) => s.key === "Pay once, use forever.")!;
+  assert.deepEqual([fresh.source, fresh.translation], ["english", null]);
+  assert.deepEqual(byId(out.translated, fresh.id).map(textContent), ["Pay once, use forever."]);
+  assert.ok(!out.segments.some((s) => s.key === "Pay once."), "the old English is gone");
+});
+
+test("an explicit segment says which entry it comes from, the page's own entry before a glob", async () => {
+  const m = manifest({
+    explicit: {
+      es: [
+        { path: "/pricing/**", en: "Pay once.", translation: "Pago único." },
+        { path: "/pricing/", en: "Pay once.", translation: "Paga una sola vez." },
+        { path: "*", en: "Pricing", translation: "Tarifas" },
+        { path: "/other/", en: "Features", translation: "Otras" },
+      ],
+    },
+  });
+  const { out } = await annotated(RICH, ES, m);
+  const pay = out.segments.find((s) => s.key === "Pay once.")!;
+  assert.deepEqual([pay.source, pay.translation, pay.entryPath], ["explicit", "Paga una sola vez.", "/pricing/"]);
+  const pricing = out.segments.find((s) => s.key === "Pricing")!;
+  assert.deepEqual([pricing.source, pricing.entryPath], ["explicit", "*"]);
+  const features = out.segments.find((s) => s.key === "Features")!;
+  assert.deepEqual([features.source, features.entryPath], ["generated", undefined], "an entry for another page doesn't apply here");
+  assert.equal(out.segments.find((s) => s.key === "Plans")!.entryPath, undefined, "only explicit segments have one");
+});
+
+test("scripts and the rest of the page's markup are left as they are", async () => {
+  const { out } = await annotated(RICH);
+  assert.match(out.english, /<link rel="stylesheet" href="\/assets\/css\/main-a{64}\.css">/);
+  assert.match(out.english, /<script type="application\/ld\+json">/);
+  assert.match(out.translated, /<link rel="stylesheet" href="\/assets\/css\/main-a{64}\.css">/);
+});
