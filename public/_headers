/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; media-src https:; connect-src 'self'; frame-src https://challenges.cloudflare.com; base-uri https:; form-action 'none'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
